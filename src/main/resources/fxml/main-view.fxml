<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.lab.controllers.MainController"
      style="-fx-padding: 20; -fx-background-color: #f5f5f5;">

    <Label text="Генератор писем с приложениями" 
           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
    
    <Separator/>
    
    <SplitPane dividerPositions="0.5">
        
        <!-- ЛЕВАЯ ПАНЕЛЬ: ФОРМА -->
        <VBox spacing="10" style="-fx-padding: 10;">
            
            <TitledPane text="Информация о получателе" animated="false" expanded="true">
                <VBox spacing="8" style="-fx-padding: 10;">
                    <Label text="Должность получателя:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="recipientPostField" promptText="Например: Старосте"/>
                    
                    <Label text="ФИО получателя:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="recipientNameField" promptText="Например: Петрову Петру Петровичу"/>
                    
                    <Label text="Организация:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="organizationField" promptText="Например: МГТУ &quot;Станкин&quot;"/>
                </VBox>
            </TitledPane>
            
            <TitledPane text="Информация об отправителе" animated="false" expanded="true">
                <VBox spacing="8" style="-fx-padding: 10;">
                    <Label text="ФИО отправителя (студент):" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="studentNameField" promptText="Например: Иванов Иван Иванович"/>
                </VBox>
            </TitledPane>
            
            <TitledPane text="Основное содержание письма" animated="false" expanded="true">
                <VBox spacing="8" style="-fx-padding: 10;">
                    <Label text="Тема письма:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="subjectField" promptText="Например: О сдаче лабораторных работ"/>
                    
                    <Label text="Тело письма:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="bodyField" promptText="Введите текст письма..." 
                              prefHeight="100" wrapText="true"/>
                </VBox>
            </TitledPane>
            
            <TitledPane text="Приложения к письму" animated="false" expanded="true">
                <VBox spacing="8" style="-fx-padding: 10;">
                    <Label text="Список приложений" style="-fx-font-weight: bold;"/>
                    <ListView fx:id="attachmentsListView" prefHeight="120"/>
                    
                    <HBox spacing="10">
                        <Button text="Добавить" onAction="#handleAddAttachmentAction"
                                style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                        <Button text="Редактировать" onAction="#handleEditAttachmentAction"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
                        <Button text="Удалить" onAction="#handleRemoveAttachmentAction"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    </HBox>
                    
                    <Label text="Для каждого приложения можно указать количество листов" 
                           style="-fx-font-size: 11; -fx-text-fill: #7f8c8d;"/>
                </VBox>
            </TitledPane>
            
            <Button fx:id="generateButton" text="Сгенерировать документ" 
                    onAction="#handleGenerateButtonAction"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14; -fx-padding: 10;"/>
            
            <Label fx:id="statusLabel" style="-fx-text-fill: #2980b9; -fx-font-size: 12;"/>
        </VBox>
        
        <!-- ПРАВАЯ ПАНЕЛЬ: ПРЕДПРОСМОТР -->
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Предпросмотр письма" style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Separator/>
            
            <ScrollPane fitToWidth="true" style="-fx-background-color: white;">
                <TextArea fx:id="previewArea" 
                          editable="false" 
                          wrapText="true"
                          style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12;"
                          promptText="Здесь будет отображаться предпросмотр письма..."/>
            </ScrollPane>
            
            <Label text="* Изменения обновляются автоматически" 
                   style="-fx-font-size: 10; -fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
        </VBox>
        
    </SplitPane>
    
</VBox>
